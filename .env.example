# Optional: enable direct contact form delivery through your EmailJS account.
# Without these values the form opens an email draft for the visitor to send.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Public URL of the KAI API (no API key belongs in the portfolio frontend).
# Leave blank to use the existing local portfolio chat responses.
VITE_KAI_API_URL=
